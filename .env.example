# Variables del entorno local de Decokasa (docker-compose.yml).
# Copia este archivo como .env en la raíz y completa los valores. .env está ignorado por Git (ADR-0015):
# nunca subas contraseñas ni claves reales, ni las pongas en este archivo.

# --- PostgreSQL 17 ---
POSTGRES_DB=decokasa
POSTGRES_USER=decokasa
# Obligatoria: sin ella docker compose no arranca. Genera una al azar, por ejemplo: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Inicio de sesión (ADR-0002) ---
# Obligatoria: al menos 32 bytes al azar. Por ejemplo: openssl rand -base64 48
JWT_SECRETO=
# Valores aprobados (D3 y D2); cambiarlos solo con una decisión registrada.
JWT_DURACION_ACCESO=15m
JWT_DURACION_RENOVACION=8h
BLOQUEO_INTENTOS_MAXIMOS=5
BLOQUEO_DURACION=15m
# Orígenes del frontend, separados por comas. /auth/renovar y /auth/cerrar-sesion rechazan cualquier otro (403).
CORS_ORIGENES=http://localhost:3000

# --- Usuarios iniciales fuera de Git (ADR-0015) ---
# Solo con la base sin usuarios. El archivo real va en backend/semilla/usuarios.local.json (ignorado por Git), con
# el formato de backend/semilla/usuarios.ejemplo.json. La contraseña temporal es la misma para todos y no va en Git.
SEMILLA_HABILITADA=false
SEMILLA_ARCHIVO=/aplicacion/semilla/usuarios.local.json
SEMILLA_CONTRASENA_TEMPORAL=

# --- Archivos (P-05 opción A) ---
# El directorio lo fija docker-compose.yml (volumen archivos-datos). Límite provisional del equipo, pendiente del
# cliente: tamaño máximo por archivo en MiB (número entero). Lo usan el backend y nginx; los dos agregan 1 MiB para el
# resto del formulario multipart.
ARCHIVOS_TAMANO_MAXIMO_MIB=100

# --- Google: solo autorización inicial local (fase 3, parte A, paso 3.1) ---
# Sin cuenta de servicio ni delegación Workspace. Desactivado hasta preparar el almacén externo privado.
# Estas variables las recibe el arranque nativo del backend; el compose base no monta secretos Google.
# Rutas absolutas fuera del repositorio; el ejemplo no contiene credenciales ni tokens.
GOOGLE_OAUTH_HABILITADA=false
GOOGLE_OAUTH_CLIENTE_RUTA=
GOOGLE_OAUTH_TOKENS_RUTA=
GOOGLE_OAUTH_LLAVE_RUTA=
GOOGLE_CUENTA_EMAIL=
# Callback fijo del cliente web: http://localhost:8080/api/v1/integraciones/google/oauth2/callback
# Modo Google En pruebas: autorización/refresh token caducan a los 7 días con Gmail/Drive.
# Preparación y autorización manual: documentos/google-oauth-paso-3.1.md

# Fase 3, paso 3.2: no activar sin autorización expresa. No hay workers en este paso.
GOOGLE_DRIVE_HABILITADA=false
GOOGLE_GMAIL_HABILITADA=false

# Fase 3, paso 3.4: no activar sin autorización expresa y parte B.
# OAuth y Drive permanecen false arriba; el worker automático requiere además este opt-in.
COPIA_DRIVE_AUTOMATICA=false
COPIA_DRIVE_LOTE=5
COPIA_DRIVE_INTERVALO_MS=30000
COPIA_DRIVE_LEASE=PT3M
# Tras fallo del intento inicial: 1 min; tras reintento 1: 5 min; tras reintento 2: 15 min.
# Tras el reintento 3 fallido: FALLIDO, no hay quinto intento. Retry-After mayor se respeta.
COPIA_DRIVE_REINTENTO_1=PT1M
COPIA_DRIVE_REINTENTO_2=PT5M
COPIA_DRIVE_REINTENTO_3=PT15M

# Fase 5, paso 5.2: detección de vencimientos. Desactivada hasta su verificación (parte B).
VENCIMIENTOS_AUTOMATICO=false

# --- Claude API (fase 7; adaptador del paso 7.4, sin ruta para preguntar hasta el paso 7.5) ---
# Desactivado. No activar fuera del entorno del piloto (F7-D3) ni sin la parte B.
IA_HABILITADA=false
# Clave NUEVA y exclusiva de Decokasa (Claude Console, workspace del piloto con su límite de gasto). No reutilices la
# clave de tus herramientas de desarrollo. Solo en tu .env local (ignorado por Git); nunca aquí, en issues ni en logs.
DECOKASA_CLAUDE_API_KEY=
# F7-D2: claude-haiku-5-5 (sujeto a verificar su disponibilidad). Vacío = IA desactivada.
IA_MODELO=
# F7-D3: solo el .env del piloto aislado lleva PILOTO_FICTICIO. Vacío = no se envía ningún documento.
IA_ENTORNO=
# F7-D6 pendiente: los documentos reales siguen bloqueados. No cambiar.
IA_DOCUMENTOS_REALES_AUTORIZADOS=false
