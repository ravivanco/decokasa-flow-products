# Variables del entorno local de Decokasa (docker-compose.yml).
# Copia este archivo como .env en la raíz y completa los valores. .env está ignorado por Git (ADR-0015):
# nunca subas contraseñas ni claves reales, ni las pongas en este archivo.

# --- PostgreSQL 17 ---
POSTGRES_DB=decokasa
POSTGRES_USER=decokasa
# Obligatoria: sin ella docker compose no arranca. Genera una al azar, por ejemplo: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Inicio de sesión (ADR-0002) ---
# Obligatoria: al menos 32 bytes al azar. Por ejemplo: openssl rand -base64 48
JWT_SECRETO=
# Valores aprobados (D3 y D2); cambiarlos solo con una decisión registrada.
JWT_DURACION_ACCESO=15m
JWT_DURACION_RENOVACION=8h
BLOQUEO_INTENTOS_MAXIMOS=5
BLOQUEO_DURACION=15m
# Orígenes del frontend, separados por comas. /auth/renovar y /auth/cerrar-sesion rechazan cualquier otro (403).
CORS_ORIGENES=http://localhost:3000

# --- Usuarios iniciales fuera de Git (ADR-0015) ---
# Solo con la base sin usuarios. El archivo real va en backend/semilla/usuarios.local.json (ignorado por Git), con
# el formato de backend/semilla/usuarios.ejemplo.json. La contraseña temporal es la misma para todos y no va en Git.
SEMILLA_HABILITADA=false
SEMILLA_ARCHIVO=/aplicacion/semilla/usuarios.local.json
SEMILLA_CONTRASENA_TEMPORAL=
