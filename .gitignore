node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Usuarios reales para la carga inicial: nunca en Git (ADR-0015). Solo se sube usuarios.ejemplo.json.
backend/semilla/*.local.json

# Archivos reales del almacenamiento local (arranque manual del backend): nunca en Git.
backend/datos/

# Enlaces simbólicos de skills (se regeneran con npx skills). Excepción: solo el SKILL.md de agregar-flujo-decokasa,
# skill propia del proyecto (fase 6, 6.B3-H02). Git no entra en un directorio excluido, por eso se abre la carpeta y
# se vuelve a excluir su contenido salvo ese archivo.
/.claude/skills/*
!/.claude/skills/agregar-flujo-decokasa/
/.claude/skills/agregar-flujo-decokasa/*
!/.claude/skills/agregar-flujo-decokasa/SKILL.md
# Archivos temporales de Word
~$*.docx

# Temporales
.tmp/
documentos/manual-paso-a-paso.docx

# Defensa adicional: OAuth Google siempre vive fuera del repositorio (paso 3.1).
**/oauth-client*.json
**/client_secret*.json
**/oauth-tokens*
**/google-aes*.key
