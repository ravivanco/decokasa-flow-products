# Variables del frontend. Copia este archivo a .env.local si necesitas cambiarlas.
# Ninguna variable con prefijo VITE_ puede contener secretos: termina en el código público del navegador.

# Base de la API (src/api/cliente.ts, función baseApi). Se lee al compilar (npm run dev o npm run build), no al
# ejecutar: cambiarla exige volver a compilar.
#  - Vacía (recomendado): se usa /api/v1 en el mismo origen. En desarrollo la envía el proxy de Vite a
#    http://localhost:8080; en Docker, el nginx del frontend al servicio backend. Es lo que exige D3b (ADR-0002):
#    la cookie de renovación es SameSite=Strict con Path /api/v1/auth y el backend comprueba Origin.
#  - Con valor: base completa incluida la versión, sin barra final, por ejemplo https://api.ejemplo.test/api/v1.
#    La API debe estar en el mismo sitio que el frontend (si no, la cookie SameSite=Strict no viaja), su
#    CORS_ORIGENES debe incluir el origen del frontend y ese origen de la API debe agregarse a connect-src en la
#    Content-Security-Policy de frontend/nginx.conf.
VITE_API_URL=

# Solo desarrollo local: abre la aplicación con un usuario ficticio sin llamar al login.
# Nunca se activa en `npm run build`, aunque esta variable esté definida.
VITE_ACCESO_LOCAL=false

# Paso 5.4 (ADR-0014, decisión técnica del equipo, provisional): cada cuántos milisegundos se vuelven a pedir las
# pantallas de seguimiento visibles. Entre 10000 y 300000; vacío o inválido: 30000. Un cambio de otra persona puede
# tardar en verse hasta este intervalo más lo que tarde la petición.
VITE_ACTUALIZACION_MS=
