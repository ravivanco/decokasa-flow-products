# Variables del frontend. Copia este archivo a .env.local si necesitas cambiarlas.
# Ninguna variable con prefijo VITE_ puede contener secretos: termina en el código público del navegador.

# Base de la API. Vacía: se usa /api/v1 y el proxy de Vite la envía a http://localhost:8080.
# Solo se define si la API está en otra dirección.
VITE_API_URL=
