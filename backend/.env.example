# Arranque manual desde backend/. Copiar como .env.local y completar los secretos.
# Spring lo lee como un archivo .properties; no usar comillas alrededor de los valores.
# Las variables de la terminal tienen prioridad sobre este archivo.
DB_URL=jdbc:postgresql://localhost:5433/decokasa
DB_USUARIO=postgres
DB_CONTRASENA=
JWT_SECRETO=
SEMILLA_HABILITADA=false
